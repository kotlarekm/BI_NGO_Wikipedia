annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["1-ogladalnosc_monthly","2-nowe_artykuly_monthly","3-nowe_rejestracje_monthly","Dim_month","4-aktywni_edytorzy_monthly","5-top_1000_artykulow_monthly","5-top_1000_artykulow_monthly_avg","7-top_100_najczesciej_edytowanych_artykulow_monthly","kategorie","top100_z_kategoriami","StartingYear","Kategoria wzrostu popularności"]

annotation PBI_ProTooling = ["DevMode"]

